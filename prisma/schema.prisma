generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Broker {
  SCHWAB_THINKORSWIM
  FIDELITY
}

enum ImportStatus {
  UPLOADED
  PARSED
  COMMITTED
  FAILED
}

enum AssetClass {
  EQUITY
  OPTION
  CASH
  OTHER
}

enum EventType {
  TRADE
  EXPIRATION_INFERRED
  ASSIGNMENT
  EXERCISE
}

enum Side {
  BUY
  SELL
}

enum OpeningClosingEffect {
  TO_OPEN
  TO_CLOSE
  UNKNOWN
}

enum AdjustmentType {
  SPLIT
  QTY_OVERRIDE
  PRICE_OVERRIDE
  ADD_POSITION
  REMOVE_POSITION
  EXECUTION_QTY_OVERRIDE
  EXECUTION_PRICE_OVERRIDE
}

enum AdjustmentStatus {
  ACTIVE
  REVERSED
}

enum PositionSnapshotStatus {
  PENDING
  COMPLETE
  FAILED
}

enum MarkAssetClass {
  EQUITY
  OPTION
}

enum MarkSource {
  MASSIVE_S3
  POLYGON_REST
  MANUAL
}

enum ValueSnapshotSource {
  RECONSTRUCTED
  BROKER_NLV
  MIXED
}

enum PipelineRunTrigger {
  SCHEDULED
  MANUAL
}

enum PipelineRunStatus {
  RUNNING
  SUCCEEDED
  NOOP
  FAILED
  SKIPPED_LOCKED
  ABANDONED
}

enum PipelineStageStatus {
  PENDING
  SKIPPED
  SUCCEEDED
  FAILED
}

enum PipelineAlertLifecycle {
  FIRING
  RESOLVED
}

enum EntityKind {
  CORPORATION
  INDIVIDUAL
}

model LegalEntity {
  id        String     @id @default(cuid())
  slug      String     @unique
  legalName String     @map("legal_name")
  kind      EntityKind
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  accounts Account[]

  @@map("legal_entities")
}

model Account {
  id              String   @id @default(cuid())
  accountId       String   @unique @map("account_id")
  label           String
  displayLabel    String?  @map("display_label")
  broker          Broker
  brokerName      String?  @map("broker_name")
  paperMoney      Boolean  @default(false) @map("paper_money")
  /// Legal owner of the account; null = unclassified (quarantined from all
  /// entity-scoped exports and denominators until the operator classifies it).
  legalEntityId   String?      @map("legal_entity_id")
  legalEntity     LegalEntity? @relation(fields: [legalEntityId], references: [id])
  startingCapital Decimal? @map("starting_capital") @db.Decimal(20, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  imports        Import[]
  executions     Execution[]
  snapshots      DailyAccountSnapshot[]
  cashEvents     CashEvent[]
  adjustments    ManualAdjustment[]
  setupGroups    SetupGroup[]
  matchedLots    MatchedLot[]
  valueSnapshots AccountValueSnapshot[]

  @@map("accounts")
}

model Import {
  id                   String       @id @default(cuid())
  filename             String
  broker               Broker
  status               ImportStatus
  parsedRows           Int          @default(0) @map("parsed_rows")
  persistedRows        Int          @default(0) @map("persisted_rows")
  skippedRows          Int          @default(0) @map("skipped_rows")
  skippedDuplicateRows Int          @default(0) @map("skipped_duplicate_rows")
  failedRows           Int          @default(0) @map("failed_rows")
  sourceFileText       String?      @map("source_file_text")
  warnings             Json?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  executions       Execution[]
  importExecutions ImportExecution[]

  @@index([accountId])
  @@map("imports")
}

model Execution {
  id                   String                @id @default(cuid())
  broker               Broker
  eventTimestamp       DateTime              @map("event_timestamp")
  tradeDate            DateTime              @map("trade_date")
  eventType            EventType             @default(TRADE) @map("event_type")
  assetClass           AssetClass            @map("asset_class")
  symbol               String
  brokerTxId           String                @map("broker_tx_id")
  instrumentKey        String?               @map("instrument_key")
  descriptionRaw       String?               @map("description_raw")
  side                 Side?
  quantity             Decimal               @db.Decimal(20, 6)
  price                Decimal?              @db.Decimal(20, 6)
  grossAmount          Decimal?              @map("gross_amount") @db.Decimal(20, 6)
  fees                 Decimal?              @db.Decimal(20, 6)
  netAmount            Decimal?              @map("net_amount") @db.Decimal(20, 6)
  openingClosingEffect OpeningClosingEffect? @map("opening_closing_effect")
  underlyingSymbol     String?               @map("underlying_symbol")
  optionType           String?               @map("option_type")
  strike               Decimal?              @db.Decimal(20, 6)
  expirationDate       DateTime?             @map("expiration_date")
  multiplier           Int?
  spreadGroupId        String?               @map("spread_group_id")
  sourceRowRef         String?               @map("source_row_ref")
  rawRowJson           Json?                 @map("raw_row_json")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  importId String @map("import_id")
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  openMatchedLots  MatchedLot[]      @relation("open_execution")
  closeMatchedLots MatchedLot[]      @relation("close_execution")
  importLinks      ImportExecution[]

  @@unique([accountId, brokerTxId])
  @@index([accountId])
  @@index([importId])
  @@index([symbol])
  @@map("executions")
}

model ImportExecution {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  importId String @map("import_id")
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  executionId String    @map("execution_id")
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([importId, executionId])
  @@index([executionId])
  @@map("import_executions")
}

model MatchedLot {
  id          String   @id @default(cuid())
  quantity    Decimal  @db.Decimal(20, 6)
  realizedPnl Decimal  @map("realized_pnl") @db.Decimal(20, 6)
  holdingDays Int      @map("holding_days")
  outcome     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  openExecutionId String    @map("open_execution_id")
  openExecution   Execution @relation("open_execution", fields: [openExecutionId], references: [id], onDelete: Cascade)

  closeExecutionId String?    @map("close_execution_id")
  closeExecution   Execution? @relation("close_execution", fields: [closeExecutionId], references: [id], onDelete: SetNull)

  setupGroupLots SetupGroupLot[]
  excursion      LotExcursion?

  @@index([accountId])
  @@map("matched_lots")
}

model SetupGroup {
  id               String   @id @default(cuid())
  tag              String
  overrideTag      String?  @map("override_tag")
  underlyingSymbol String   @map("underlying_symbol")
  realizedPnl      Decimal? @map("realized_pnl") @db.Decimal(20, 6)
  winRate          Decimal? @map("win_rate") @db.Decimal(8, 4)
  expectancy       Decimal? @db.Decimal(20, 6)
  averageHoldDays  Decimal? @map("average_hold_days") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lots SetupGroupLot[]

  @@index([accountId])
  @@map("setup_groups")
}

model SetupGroupLot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  setupGroupId String     @map("setup_group_id")
  setupGroup   SetupGroup @relation(fields: [setupGroupId], references: [id], onDelete: Cascade)

  matchedLotId String     @map("matched_lot_id")
  matchedLot   MatchedLot @relation(fields: [matchedLotId], references: [id], onDelete: Cascade)

  @@unique([setupGroupId, matchedLotId])
  @@map("setup_group_lots")
}

model DailyAccountSnapshot {
  id                        String   @id @default(cuid())
  snapshotDate              DateTime @map("snapshot_date")
  balance                   Decimal  @db.Decimal(20, 6)
  totalCash                 Decimal? @map("total_cash") @db.Decimal(20, 6)
  brokerNetLiquidationValue Decimal? @map("broker_net_liquidation_value") @db.Decimal(20, 6)
  sourceRef                 String?  @map("source_ref")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("daily_account_snapshots")
}

model PositionSnapshot {
  id                String                 @id @default(cuid())
  accountIds        String                 @map("account_ids")
  snapshotAt        DateTime               @default(now()) @map("snapshot_at")
  status            PositionSnapshotStatus @default(PENDING)
  errorMessage      String?                @map("error_message")
  positionsJson     String                 @map("positions_json")
  accountValuesJson String                 @default("[]") @map("account_values_json")
  unrealizedPnl     Decimal?               @map("unrealized_pnl") @db.Decimal(20, 6)
  realizedPnl       Decimal?               @map("realized_pnl") @db.Decimal(20, 6)
  cashAdjustments   Decimal?               @map("cash_adjustments") @db.Decimal(20, 6)
  manualAdjustments Decimal?               @map("manual_adjustments") @db.Decimal(20, 6)
  currentNlv        Decimal?               @map("current_nlv") @db.Decimal(20, 6)
  startingCapital   Decimal?               @map("starting_capital") @db.Decimal(20, 6)
  totalGain         Decimal?               @map("total_gain") @db.Decimal(20, 6)
  unexplainedDelta  Decimal?               @map("unexplained_delta") @db.Decimal(20, 6)
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([snapshotAt(sort: Desc)])
  @@map("position_snapshots")
}

model CashEvent {
  id          String   @id @default(cuid())
  eventDate   DateTime @map("event_date")
  rowType     String   @map("row_type")
  refNumber   String   @map("ref_number")
  description String
  amount      Decimal  @db.Decimal(20, 6)
  sourceRef   String?  @map("source_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, refNumber])
  @@index([accountId])
  @@index([eventDate])
  @@map("cash_events")
}

model ManualAdjustment {
  id                     String           @id @default(cuid())
  createdAt              DateTime         @default(now()) @map("created_at")
  createdBy              String           @map("created_by")
  symbol                 String
  effectiveDate          DateTime         @map("effective_date")
  adjustmentType         AdjustmentType   @map("adjustment_type")
  payloadJson            Json             @map("payload_json")
  reason                 String
  evidenceRef            String?          @map("evidence_ref")
  status                 AdjustmentStatus @default(ACTIVE)
  reversedByAdjustmentId String?          @map("reversed_by_adjustment_id")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  reversedBy ManualAdjustment?  @relation("ReversalChain", fields: [reversedByAdjustmentId], references: [id], onDelete: SetNull)
  reversals  ManualAdjustment[] @relation("ReversalChain")

  @@index([accountId, symbol, effectiveDate])
  @@index([status, effectiveDate])
  @@map("manual_adjustments")
}

/// Daily OHLC for one instrument (equity symbol or option contract).
/// instrumentKey is the canonical key defined in 00-overview §7.
model HistoricalMark {
  id            String         @id @default(cuid())
  instrumentKey String         @map("instrument_key")
  assetClass    MarkAssetClass @map("asset_class")
  /// Equity: symbol. Option: underlying symbol. Useful for filtering/backfill.
  symbol        String
  markDate      DateTime       @map("mark_date") @db.Date
  open          Decimal        @db.Decimal(20, 6)
  high          Decimal        @db.Decimal(20, 6)
  low           Decimal        @db.Decimal(20, 6)
  close         Decimal        @db.Decimal(20, 6)
  volume        Decimal?       @db.Decimal(28, 6)
  source        MarkSource     @default(MASSIVE_S3)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([instrumentKey, markDate])
  @@index([symbol, markDate])
  @@index([markDate])
  @@map("historical_marks")
}

/// Materialized daily account value, split by asset class. One row per account/date.
/// This is what GET /api/analysis/account-value-series reads.
model AccountValueSnapshot {
  id                    String              @id @default(cuid())
  snapshotDate          DateTime            @map("snapshot_date") @db.Date
  cashValue             Decimal             @map("cash_value") @db.Decimal(20, 6)
  equityValue           Decimal             @map("equity_value") @db.Decimal(20, 6)
  optionValue           Decimal             @map("option_value") @db.Decimal(20, 6)
  totalValue            Decimal             @map("total_value") @db.Decimal(20, 6)
  /// Broker-reported NLV for this date if available (for reconciliation only).
  brokerNlv             Decimal?            @map("broker_nlv") @db.Decimal(20, 6)
  /// brokerNlv - totalValue when both present; null otherwise.
  reconcileDelta        Decimal?            @map("reconcile_delta") @db.Decimal(20, 6)
  /// Count of held instruments with no mark on this date (data-quality signal).
  unpricedPositionCount Int                 @default(0) @map("unpriced_position_count")
  source                ValueSnapshotSource @default(RECONSTRUCTED)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("account_value_snapshots")
}

/// Short-lived ownership record preventing overlapping scheduled pipeline runs.
/// Durable run history lives in ScheduledPipelineRun, not this lease table.
model ScheduledJobLease {
  jobName        String   @id @map("job_name")
  leaseOwner     String   @map("lease_owner")
  leaseExpiresAt DateTime @map("lease_expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([leaseExpiresAt])
  @@map("scheduled_job_leases")
}

/// Durable per-run history for the scheduled market-data pipeline. One row per
/// attempt, written as RUNNING before work begins and finalized on every exit
/// path. Read by GET /api/scheduler/status and GET /api/scheduler/runs.
model ScheduledPipelineRun {
  id      String             @id @default(cuid())
  jobName String             @map("job_name")
  trigger PipelineRunTrigger @default(SCHEDULED)
  status  PipelineRunStatus  @default(RUNNING)

  /// Lease owner that claimed this run; ties a row to its lease for recovery.
  leaseOwner     String    @map("lease_owner")
  /// Lease expiry at claim time. A RUNNING row past this is recoverable.
  leaseExpiresAt DateTime? @map("lease_expires_at")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")

  /// Range explicitly requested by the caller, when one was supplied.
  requestedStartDate DateTime? @map("requested_start_date") @db.Date
  requestedEndDate   DateTime? @map("requested_end_date") @db.Date
  /// Range the pipeline actually derived and worked on.
  effectiveStartDate DateTime? @map("effective_start_date") @db.Date
  effectiveEndDate   DateTime? @map("effective_end_date") @db.Date
  eligibleEndDate    DateTime? @map("eligible_end_date") @db.Date
  commonMarkDate     DateTime? @map("common_mark_date") @db.Date

  equityStatus      PipelineStageStatus @default(PENDING) @map("equity_status")
  equityRowCount    Int?                @map("equity_row_count")
  optionStatus      PipelineStageStatus @default(PENDING) @map("option_status")
  optionRowCount    Int?                @map("option_row_count")
  valuesStatus      PipelineStageStatus @default(PENDING) @map("values_status")
  valuesRowCount    Int?                @map("values_row_count")
  excursionStatus   PipelineStageStatus @default(PENDING) @map("excursion_status")
  excursionRowCount Int?                @map("excursion_row_count")

  /// Freshness observed at the end of the run, for lag reporting without a re-query.
  latestEquityMarkDate    DateTime? @map("latest_equity_mark_date") @db.Date
  latestOptionMarkDate    DateTime? @map("latest_option_mark_date") @db.Date
  latestValueSnapshotDate DateTime? @map("latest_value_snapshot_date") @db.Date

  unpricedPositionCount Int? @map("unpriced_position_count")
  unpricedExcursionDays Int? @map("unpriced_excursion_days")

  /// Sanitized failure message only — never raw provider payloads or secrets.
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobName, startedAt])
  @@index([status])
  @@index([startedAt])
  @@map("scheduled_pipeline_runs")
}

/// Dedup state for external pipeline alerts. One row per alert key; keeps a
/// firing alert from re-sending every run and enables a single recovery notice.
model PipelineAlertState {
  alertKey    String                 @id @map("alert_key")
  jobName     String                 @map("job_name")
  state       PipelineAlertLifecycle @default(FIRING)
  /// Distinguishes a materially changed alert from a repeat of the same one.
  signature   String?
  firstSeenAt DateTime               @map("first_seen_at")
  lastSentAt  DateTime               @map("last_sent_at")
  resolvedAt  DateTime?              @map("resolved_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@index([jobName])
  @@map("pipeline_alert_states")
}

/// Per matched-lot maximum favorable / adverse excursion. Populated by story 08.
model LotExcursion {
  id           String    @id @default(cuid())
  /// $ best unrealized gain during the holding window (>= 0 expected, but store raw).
  mfe          Decimal   @db.Decimal(20, 6)
  /// $ worst unrealized loss during the holding window (<= 0 expected, but store raw).
  mae          Decimal   @db.Decimal(20, 6)
  /// As a fraction of cost basis (e.g. 0.25 = +25%). Null if cost basis is 0.
  mfePct       Decimal?  @map("mfe_pct") @db.Decimal(12, 6)
  maePct       Decimal?  @map("mae_pct") @db.Decimal(12, 6)
  mfeDate      DateTime? @map("mfe_date") @db.Date
  maeDate      DateTime? @map("mae_date") @db.Date
  /// Number of trading days in the window that had a usable mark.
  pricedDays   Int       @default(0) @map("priced_days")
  /// Number of trading days in the window with NO mark (data-quality signal).
  unpricedDays Int       @default(0) @map("unpriced_days")
  computedAt   DateTime  @default(now()) @map("computed_at")

  matchedLotId String     @unique @map("matched_lot_id")
  matchedLot   MatchedLot @relation(fields: [matchedLotId], references: [id], onDelete: Cascade)

  @@map("lot_excursions")
}

enum RecommendationPass {
  PASS1
  PASS2
}

enum RecommendationDisposition {
  ELIGIBLE
  NO_TRADE
  WAIT
  VALIDATED
  FLAGGED
  REJECTED
}

model TradeRecommendation {
  id                   String                    @id @default(cuid())
  recId                String                    @unique @map("rec_id")
  lineageId            String                    @map("lineage_id")
  localRecId           String                    @map("local_rec_id")
  pass                 RecommendationPass
  disposition          RecommendationDisposition
  asOf                 DateTime                  @map("as_of")
  decidedAtRaw         String?                   @map("decided_at_raw")
  decidedAt            DateTime?                 @map("decided_at")
  ticker               String
  structure            String?
  structureRaw         String?                   @map("structure_raw")
  direction            String?
  reason               String?
  optionType           String?                   @map("option_type")
  strike               Decimal?                  @db.Decimal(20, 6)
  strikeShort          Decimal?                  @map("strike_short") @db.Decimal(20, 6)
  expirationDate       DateTime?                 @map("expiration_date")
  entryRangeLow        Decimal?                  @map("entry_range_low") @db.Decimal(20, 6)
  entryRangeHigh       Decimal?                  @map("entry_range_high") @db.Decimal(20, 6)
  entryRangeRaw        String?                   @map("entry_range_raw")
  sizingBand           String?                   @map("sizing_band")
  chainQuality         String?                   @map("chain_quality")
  optionMid            Decimal?                  @map("option_mid") @db.Decimal(20, 6)
  underlyingRef        Decimal?                  @map("underlying_ref") @db.Decimal(20, 6)
  journalSchemaVersion String?                   @map("journal_schema_version")
  sourceFile           String?                   @map("source_file")
  raw                  Json?
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@index([lineageId])
  @@index([ticker])
  @@index([pass, disposition])
  @@index([ticker, expirationDate])
  @@map("trade_recommendations")
}

enum QueueItemKind {
  WYCKOFF_FLAGGED
}

enum QueueStatement {
  ACCEPT
  OVERRIDE
  ESTIMATE
  DEFER
}

enum QueueResolution {
  PIPELINE_ACCEPTED_FRESH
  DECLARED_ACCEPT
  DECLARED_OVERRIDE
  ESTIMATION_PATH
  DEFERRED
  RETURNED_DIVERGED
}

model QueueItem {
  id                  String        @id @default(cuid())
  queueItemId         String        @unique @map("queue_item_id")
  queueSchemaVersion  String        @map("queue_schema_version")
  kind                QueueItemKind
  createdAtSource     DateTime      @map("created_at_source")
  ticker              String
  lineageId           String        @map("lineage_id")
  recId               String?       @map("rec_id")
  exportedAt          DateTime      @map("exported_at")
  asOf                DateTime      @map("as_of")
  viewerSchemaVersion String?       @map("viewer_schema_version")
  proposalSnapshot    Json          @map("proposal_snapshot")
  proposalHash        String        @map("proposal_hash")
  createdAt           DateTime      @default(now()) @map("created_at")

  declarations QueueDeclaration[]
  outcomes     QueueOutcome[]

  @@index([ticker])
  @@index([lineageId])
  @@map("queue_items")
}

model QueueDeclaration {
  id               String         @id @default(cuid())
  declarationId    String         @unique @map("declaration_id")
  proposalHash     String         @map("proposal_hash")
  statement        QueueStatement
  overrideReading  Json?          @map("override_reading")
  operatorNote     String?        @map("operator_note")
  statedAt         DateTime       @map("stated_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  queueItemId String    @map("queue_item_id")
  queueItem   QueueItem @relation(fields: [queueItemId], references: [queueItemId], onDelete: Cascade)

  @@index([queueItemId])
  @@map("queue_declarations")
}

model QueueOutcome {
  id                 String          @id @default(cuid())
  outcomeId          String          @unique @map("outcome_id")
  declarationId      String?         @map("declaration_id")
  consumedAt         DateTime        @map("consumed_at")
  consumingLineageId String          @map("consuming_lineage_id")
  comparison         Json
  resolution         QueueResolution
  resultingStatus    String          @map("resulting_status")
  createdAt          DateTime        @default(now()) @map("created_at")

  queueItemId String    @unique @map("queue_item_id")
  queueItem   QueueItem @relation(fields: [queueItemId], references: [queueItemId], onDelete: Cascade)

  @@map("queue_outcomes")
}
