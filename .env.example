DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/kapman
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Required only for live quote features; app remains functional for non-quote features when unset
MCP_SERVER_URL=
# Optional bearer auth for MCP endpoint; app remains functional for non-quote features when unset
MCP_BEARER_TOKEN=

# Optional HTTP Basic Auth gate (src/middleware.ts). Set BOTH in production
# (e.g. `fly secrets set BASIC_AUTH_USER=... BASIC_AUTH_PASSWORD=...`) to require
# a login on every request. When either is unset the gate is bypassed, so local
# dev, docker compose, and tests run without authentication.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Massive/Polygon S3 flat files (historical marks). Required only for the
# account-value-curve backfill; the rest of the app works without them.
S3_ENDPOINT_URL=https://files.massive.com
S3_BUCKET=flatfiles
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POLYGON_S3_EQUITY_PREFIX=us_stocks_sip/day_aggs_v1
POLYGON_S3_OPTIONS_PREFIX=us_options_opra/day_aggs_v1
# Option historical mark ingestion clamps requests to the plan's available
# history. Default is a two-year rolling window, starting the day after the
# boundary to avoid out-of-contract calls.
POLYGON_HISTORICAL_LOOKBACK_YEARS=2
# Optional exact override if the plan entitlement changes or Massive provides a
# fixed account-specific start date. Format: YYYY-MM-DD.
POLYGON_HISTORICAL_MARKS_START_DATE=
# Optional fallback for option historical marks when OPRA S3 objects are not
# available on the current Massive/Polygon plan.
POLYGON_API_KEY=
# Scheduled market-data job waits this many UTC calendar days before considering
# a provider date eligible. Optional; defaults to 2.
MARKET_DATA_PUBLICATION_LAG_DAYS=2
# Database lease expiry for a scheduled market-data run. Optional; defaults to 60.
MARKET_DATA_PIPELINE_LEASE_MINUTES=60
# Durable run history for the scheduled market-data job is retained this many
# days; finalized runs older than the window are pruned at the end of each run.
# Optional; defaults to 90.
MARKET_DATA_RUN_RETENTION_DAYS=90

# --- Optional external alerts for the scheduled market-data pipeline ---
# Everything below is optional. With PIPELINE_ALERT_WEBHOOK_URL unset, alerting
# is disabled entirely and the pipeline behaves exactly as it does today.
# When set, the pipeline POSTs JSON to this URL for failed runs, abandoned runs,
# repeated lock contention, and data-freshness lag, plus one recovery notice
# after a condition clears. Delivery failures are logged, never fatal.
PIPELINE_ALERT_WEBHOOK_URL=
# Alert when any mark or account-value source falls further behind than this
# many days. Optional; defaults to 4.
PIPELINE_ALERT_FRESHNESS_LAG_DAYS=4
# Alert after this many consecutive runs are skipped because another run held
# the lease. Optional; defaults to 3.
PIPELINE_ALERT_LOCK_CONTENTION_THRESHOLD=3
# Suppress an unchanged, still-firing alert for this many minutes before
# re-sending it. Optional; defaults to 720 (12 hours).
PIPELINE_ALERT_REPEAT_MINUTES=720
# Webhook request timeout in milliseconds. Optional; defaults to 10000.
PIPELINE_ALERT_TIMEOUT_MS=10000

# Payload shape for the alert webhook. Auto-detected from the URL host
# (hooks.slack.com -> slack, discord.com -> discord, everything else ->
# structured JSON). Set explicitly only to override: slack | discord | generic.
PIPELINE_ALERT_FORMAT=

# --- Dead-man's-switch heartbeat (recommended; independent of alerts above) ---
# The webhook alerts above run INSIDE the pipeline, so they cannot fire when the
# pipeline does not run at all — the exact failure that left production stale
# from 2026-07-19 to 2026-08-16. This inverts it: the pipeline POSTs to this URL
# after every successful or no-op run, and an external monitor
# (healthchecks.io, Better Stack, Cronitor, ...) alerts when the ping stops.
# Deliberately NOT pinged on failure, so a failing run also trips the switch.
# Leave unset to disable. Ping failures are logged and never fail a run.
PIPELINE_HEARTBEAT_URL=
# Heartbeat request timeout in milliseconds. Optional; defaults to 10000.
PIPELINE_HEARTBEAT_TIMEOUT_MS=10000
